{
  "name": "lostnet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "mock:api": "node scripts/mock-api.mjs",
    "build": "astro build",
    "preview": "astro preview",
