    "leaflet": "^1.9.4"
  },
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.13.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "msw": "3.0.3",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
